# ── Supabase ──────────────────────────────────────────────────────────────
# Públicas por diseño: RLS es la frontera de seguridad, no estas claves.
VITE_SUPABASE_URL=https://ralolxpdifvnizpubuju.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Proveedores de IA ─────────────────────────────────────────────────────
# SIN prefijo VITE_. Solo las lee api/ai.js; nunca llegan al navegador.
# Configura al menos una. Groq y Gemini son gratis.
GROQ_API_KEY=your_groq_api_key          # https://console.groq.com
GEMINI_API_KEY=your_gemini_key          # https://aistudio.google.com/app/apikey
ANTHROPIC_API_KEY=your_anthropic_key    # https://console.anthropic.com
OPENAI_API_KEY=your_openai_key          # https://platform.openai.com/api-keys

# ── Sincronización con Google Calendar ────────────────────────────────────
# Las mismas credenciales OAuth que ya usa el login de Supabase.
# Están en Google Cloud → APIs y servicios → Credenciales.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Necesaria para leer el refresh_token de Google, que está deliberadamente fuera
# del alcance del rol authenticated. Supabase → Project Settings → API →
# service_role. Es una clave con permisos totales: solo en el servidor, jamás
# con prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
